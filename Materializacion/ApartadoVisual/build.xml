<?xml version="1.0" encoding="UTF-8"?>
<project name="ApartadoVisual" default="default" basedir=".">
    <description>Builds, tests, and runs the project ApartadoVisual.</description>
    
    <import file="nbproject/build-impl.xml"/>

    <property name="main.class" value="tu.paquete.TuClasePrincipal"/>

    <target name="jar" depends="init,compile" description="Fuerza la creación del JAR para Swing">
        <echo message="----------------------------------------------------------"/>
        <echo message="--- FORZANDO LA CREACIÓN DEL JAR (MODO SWING / JDK 22) ---"/>
        <echo message="----------------------------------------------------------"/>
        
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/${ant.project.name}.jar" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
        
        <echo message="¡ÉXITO! Tu archivo ejecutable se ha creado en: ${dist.dir}"/>
    </target>
</project>